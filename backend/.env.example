# VisionAI Backend — environment configuration
# Copy this file to backend/.env and fill in every value. Never commit .env.

# ── Flask core ────────────────────────────────────────────────────────────────
# Minimum 16 characters. Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-high-entropy-random-string
FLASK_ENV=development
PREFERRED_URL_SCHEME=http

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated whitelist of frontend origins. Wildcards are rejected at boot.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Service-account key: Firebase Console -> Project Settings -> Service Accounts.
# Relative paths resolve against the backend/ directory.
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_STORAGE_BUCKET=eyediseaseclassifier.firebasestorage.app
# Costs one extra round-trip per request; enable only if you revoke tokens.
CHECK_TOKEN_REVOKED=false

# ── AI model ──────────────────────────────────────────────────────────────────
# Ensemble CNN Classifier (EfficientNetB3 + DenseNet121 + InceptionResNetV2) — 95.42% test accuracy
# Fine-tuned by: Karthikeya Chavala
LOCAL_MODEL_ID=models/ensemble_classifier.pth
TORCH_DEVICE=cpu
# 120s budget for the 3-model ensemble (~276 MB checkpoint)
MODEL_LOAD_TIMEOUT_SECONDS=120

# ── Rate limiting ─────────────────────────────────────────────────────────────
DEFAULT_RATE_LIMITS=200 per day,50 per hour
PREDICT_RATE_LIMIT=10 per minute
USER_SYNC_RATE_LIMIT=20 per hour
SCANS_RATE_LIMIT=60 per hour
ADMIN_RATE_LIMIT=60 per minute
# Use redis://... in production so limits are shared across workers.
RATELIMIT_STORAGE_URI=memory://

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated emails that are auto-promoted to admin on first user sync.
# Run `python promote_admin.py <email>` to promote an existing user immediately.
ADMIN_EMAILS=
