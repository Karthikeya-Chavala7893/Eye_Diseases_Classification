# VisionAI Frontend — environment configuration
# Copy this file to frontend/.env.local and fill in your Firebase web app values.

# ── Flask backend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Firebase Web SDK ──────────────────────────────────────────────────────────
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> Config.
# These values are intentionally public: they identify the project, they do not
# authenticate it. Security comes from Firebase Security Rules plus the backend's
# JWT verification.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=eyediseaseclassifier.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eyediseaseclassifier
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eyediseaseclassifier.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
